{{ ansible_managed | comment }}
# Generated by david_igou.armbian.disk_provision.
# Source: layout entry id={{ partition.id }}

{# Translate DSL type names to systemd-repart's canonical names.
   `linux` is the user-friendly DSL value; systemd-repart wants
   `linux-generic`. Other DSL types map 1:1. #}
{% set _type_map = {'linux': 'linux-generic'} %}
[Partition]
Type={{ _type_map.get(partition.type, partition.type) }}
{% if partition.label is defined %}
Label={{ partition.label }}
{% endif %}
Format={{ partition.format }}
{% if partition.size == 'grow' %}
SizeMinBytes=4G
{% else %}
SizeMinBytes={{ partition.size | regex_replace('iB$', '') }}
SizeMaxBytes={{ partition.size | regex_replace('iB$', '') }}
{% endif %}
