# pxelinux.cfg for {{ inventory_hostname }} ({{ board_model }})
# Mode: {{ netboot_mode }}
# MAC: {{ board_mac }}
# Generated by Ansible — do not edit manually.

DEFAULT {{ netboot_mode }}

LABEL nfsroot
  MENU LABEL Armbian NFS Root ({{ board_model }})
  KERNEL armbian/{{ board_model }}/vmlinuz
  INITRD armbian/{{ board_model }}/initrd.img
  FDT    armbian/{{ board_model }}/board.dtb
  APPEND root=/dev/nfs \
    nfsroot={{ netboot_server_ip }}:{{ nfs_rootfs_path }}/{{ board_model }},vers=4,ro \
    ip=dhcp \
    console={{ board_configs[board_model].console }} \
    rootwait \
    rw

LABEL reprovision
  MENU LABEL Reprovision Disk ({{ board_model }})
  KERNEL armbian/{{ board_model }}/vmlinuz
  INITRD armbian/{{ board_model }}/initrd.img
  FDT    armbian/{{ board_model }}/board.dtb
  APPEND root=/dev/nfs \
    nfsroot={{ netboot_server_ip }}:{{ nfs_rootfs_path }}/{{ board_model }},vers=4,rw \
    ip=dhcp \
    console={{ board_configs[board_model].console }} \
    rootwait \
    rw
