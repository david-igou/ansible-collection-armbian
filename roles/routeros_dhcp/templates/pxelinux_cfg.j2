# pxelinux.cfg for {{ target_board_host }} ({{ board_model }})
# MAC: {{ board_mac }}
# Generated by Ansible — do not edit manually.

DEFAULT nfsroot

LABEL nfsroot
  MENU LABEL Armbian NFS Root ({{ target_board_host }})
  KERNEL armbian/{{ board_model }}/vmlinuz
  INITRD armbian/{{ board_model }}/initrd.img
  FDT    armbian/{{ board_model }}/board.dtb
  APPEND root=/dev/nfs \
    nfsroot={{ nfs_server_ip | default(netboot_server_ip) }}:{{ nfs_rootfs_path }}/{{ target_board_host }},vers=4,ro \
    ip=dhcp \
    console={{ board_configs[board_model].console }} \
    rootwait \
    rw
