# pxelinux.cfg for {{ target_board_host }} ({{ board_model }})
# MAC: {{ board_mac }}
# Generated by Ansible — do not edit manually.

DEFAULT nfsroot

LABEL nfsroot
  MENU LABEL Armbian NFS Root ({{ target_board_host }})
  KERNEL armbian/{{ board_model }}/vmlinuz
  INITRD armbian/{{ board_model }}/initrd.img
  FDT    armbian/{{ board_model }}/board.dtb
  # Single-line APPEND: U-Boot's PXE bootmeth does not honor backslash
  # line continuations — each subsequent line becomes "Ignoring unknown
  # command:", and only the first line's args reach the kernel cmdline.
  #
  # nfsvers=3: Debian klibc-nfs in the initramfs only supports NFS v2/v3.
  # Using vers=4 makes nfsmount fail with "bad NFS version '4'" and the
  # board falls into a rescue (initramfs) prompt. v4 root mount would
  # require either nfs-utils' mount.nfs in the initramfs (extra hooks)
  # or kernel-side NFS root via CONFIG_ROOT_NFS_V4 (kernel rebuild).
  #
  # rw: each board has its own per-host rootfs at
  # nfs_rootfs_path/<inventory_hostname>/, so concurrent writes from
  # different boards do not collide. RW is required for first-boot
  # ssh-keygen to write /etc/ssh/ssh_host_*_key (per_host.yml deletes
  # them) and for systemd-machine-id-setup to write /etc/machine-id —
  # without RW those services fail and the board has no SSH access.
  APPEND root=/dev/nfs nfsroot={{ nfs_server_ip | default(netboot_server_ip) }}:{{ nfs_rootfs_path }}/{{ target_board_host }},nfsvers=3,rw ip=dhcp console={{ board_configs[board_model].console }} rootwait rw
