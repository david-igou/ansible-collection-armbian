{# Macro: render_localcmd_chain(board_cfg, overrides={}) renders a
   single U-Boot command-chain string used as the localcmd value for
   the `local_kernel` boot mode.

   Inputs:
     board_cfg: an entry from armbian_netboot_board_configs (must have
                local_kernel.{storage_dev,storage_scan}, dtb, console).
     overrides: optional dict with keys that override the board defaults.
                Supported override keys: storage_dev, storage_scan,
                root_label, console, dtb.

   Output: single-line U-Boot command string ending in `booti`.

   Chain shape (GPT-label partition lookup — board-agnostic):
     setenv bootargs root=LABEL=<root_label> rootfstype=ext4 rootwait rw console=<console>;
     <storage_scan>;
     gpt setenv <storage_dev> 0 -p <root_label>;
     ext4load <storage_dev> 0:${gpt_partition_number} ${kernel_addr_r} /boot/Image;
     ext4load <storage_dev> 0:${gpt_partition_number} ${ramdisk_addr_r} /boot/uInitrd;
     setenv ramdisk_size ${filesize};
     ext4load <storage_dev> 0:${gpt_partition_number} ${fdt_addr_r} /boot/dtb/<dtb>;
     booti ${kernel_addr_r} ${ramdisk_addr_r}:${ramdisk_size} ${fdt_addr_r}

   `gpt setenv <dev> 0 -p <label>` looks up the partition whose GPT
   PARTLABEL matches <root_label> and sets U-Boot env vars
   ${gpt_partition_number}, ${gpt_partition_addr}, ${gpt_partition_size},
   and ${gpt_partition_name}. Using `gpt setenv` instead of
   `part number ... \#<label>` avoids the hush `#` comment-start issue
   entirely — the partition name is passed as a plain `-p` argument.
   This makes the chain work regardless of whether the root partition is
   p2 (2-partition layout: opi5pro/opi5/rock-5a/rock-5b) or p4
   (4-partition layout: opi5max v1 with ESP+boot+var+root). The
   ${gpt_partition_number} tokens are U-Boot env var references resolved
   at runtime — Jinja does not substitute them.

   Collection-level defaults (not overridable here — they're invariants
   of the Armbian rootfs layout):
     kernel_path:  /boot/Image
     initrd_path:  /boot/uInitrd
     rootfstype:   ext4
     root_label:   armbi_root_local  (overridable; matches pxelinux_render default)

   Consumed by:
     - playbooks/build_image.yml's __999_local_kernel_bake hook (Task 4)
     - playbooks/tasks/compose_uboot_env_vars.yml (Task 6)
#}
{%- macro render_localcmd_chain(board_cfg, overrides={}) -%}
{%- set lk = board_cfg.local_kernel -%}
{%- set storage_dev  = overrides.storage_dev  | default(lk.storage_dev) -%}
{%- set storage_scan = overrides.storage_scan | default(lk.storage_scan) -%}
{%- set root_label   = overrides.root_label   | default('armbi_root_local') -%}
{%- set console      = overrides.console      | default(board_cfg.console) -%}
{%- set dtb          = overrides.dtb          | default(board_cfg.dtb) -%}
setenv bootargs root=LABEL={{ root_label }} rootfstype=ext4 rootwait rw console={{ console }};
{{- ' ' }}{{ storage_scan }};
{{- ' ' }}gpt setenv {{ storage_dev }} 0 -p {{ root_label }};
{{- ' ' }}ext4load {{ storage_dev }} 0:${gpt_partition_number} ${kernel_addr_r} /boot/Image;
{{- ' ' }}ext4load {{ storage_dev }} 0:${gpt_partition_number} ${ramdisk_addr_r} /boot/uInitrd;
{{- ' ' }}setenv ramdisk_size ${filesize};
{{- ' ' }}ext4load {{ storage_dev }} 0:${gpt_partition_number} ${fdt_addr_r} /boot/dtb/{{ dtb }};
{{- ' ' }}booti ${kernel_addr_r} ${ramdisk_addr_r}:${ramdisk_size} ${fdt_addr_r}
{%- endmacro -%}
