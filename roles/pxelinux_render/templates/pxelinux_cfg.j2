{{ ansible_managed | comment }}
{% macro stanza(name, menu_label, append) %}
label {{ name }}
  menu label {{ menu_label }} ({{ pxelinux_render_hostname }})
  kernel {{ pxelinux_render_tftp_kernel }}
  initrd {{ pxelinux_render_tftp_initrd }}
{% if pxelinux_render_tftp_dtb | length > 0 %}
  fdt    {{ pxelinux_render_tftp_dtb }}
{% endif %}
  append {{ append }} console={{ pxelinux_render_console }}{{ __pxelinux_render_verbose_args }}
{% endmacro %}
# pxelinux.cfg for {{ pxelinux_render_hostname }}{{ (' (' ~ pxelinux_render_board_name ~ ')') if pxelinux_render_board_name | length > 0 else '' }}
# MAC: {{ pxelinux_render_board_mac }}

default {{ pxelinux_render_boot_mode }}
timeout 50
prompt  0

{{ stanza('nfs', 'Armbian NFS root', 'root=/dev/nfs nfsroot=' ~ pxelinux_render_nfs_server_ip ~ ':' ~ pxelinux_render_nfs_root_path ~ '/' ~ pxelinux_render_hostname ~ ',nfsvers=' ~ pxelinux_render_nfs_version ~ ',rw ip=dhcp rootwait rw') }}
{{ stanza('sd', 'Armbian on SD', 'root=' ~ pxelinux_render_sd_root ~ ' rootfstype=ext4 rootwait rw') }}
{{ stanza('local', 'Armbian on local disk', 'root=' ~ pxelinux_render_local_root ~ ' rootfstype=ext4 rootwait rw') }}
label local_kernel
  menu label Boot the local disk's kernel ({{ pxelinux_render_hostname }})
  localboot 0
{% for mode_name, mode in pxelinux_render_extra_modes.items() %}

{{ stanza(mode_name, mode.menu_label, 'root=' ~ mode.root ~ ' rootfstype=' ~ mode.rootfstype | default('ext4') ~ ' rootwait rw' ~ ((' ' ~ mode.extra_append) if mode.extra_append is defined else '')) }}
{%- endfor %}
