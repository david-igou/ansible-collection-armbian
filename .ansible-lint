---
profile: min

exclude_paths:
  - extensions/molecule/provisioners/
  - tests/
  - changelogs/

warn_list:
  - command-instead-of-module

skip_list:
  # Cross-role interface variables (board_mac, board_model, etc.) are
  # deliberately shared across roles and don't use per-role prefixes.
  - var-naming[no-role-prefix]

# External collections from requirements.yml (community.routeros,
# ansible.posix, ansible.netcommon) must be installed before lint —
# `make install` does it. We do NOT use ansible-lint's `mock_modules`
# directive: it writes stub modules into the discovered collections
# path on every lint run, silently overwriting the real installed
# modules and causing later playbook runs to fail with
# "Unsupported parameters" because the stub's argument_spec is empty.
use_default_rules: true
offline: true
